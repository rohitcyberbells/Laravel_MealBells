# Local development. This is what `composer run setup` copies to .env.
#
# It differs from .env.example (which is production-shaped) only in the values
# marked below. Keep the two in step when you add a variable.

APP_NAME=MealBells
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Only used by the 'daily' channel, which production uses.
# LOG_DAILY_DAYS=14

# SQLite needs no server; `php artisan migrate` creates the file. Swap to pgsql
# and fill these in to develop against the production database engine.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=mealbells
# DB_USERNAME=mealbells
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false locally: there is no certificate on http://localhost, and a secure-only
# cookie would simply never be sent.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 'sync' runs jobs inline, so no worker is needed to see notifications.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Writes mail to storage/logs instead of sending it.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mealbells.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# MealBells engine
#--------------------------------------------------------------------------
# Every value below is optional: the defaults in config/mealbells.php and
# config/hrms.php are the ones shipped. They are listed so an operator knows
# the knobs exist.

# How far ahead a meal may be recorded. Leave beyond this is reported as
# outside the window rather than applied.
# MEALBELLS_ADVANCE_LIMIT_DAYS=60
# MEALBELLS_MAX_EXTRA_MEALS=100
# MEALBELLS_MAX_IMPORT_ROWS=2000

# How long the operational tables keep rows. They hold no meal records, but
# they carry user ids and job payloads. Failed jobs are kept longer than a
# session because one may still be worth retrying.
# MEALBELLS_RETENTION_SESSIONS_DAYS=30
# MEALBELLS_RETENTION_NOTIFICATIONS_DAYS=90
# MEALBELLS_RETENTION_FAILED_JOBS_DAYS=30

#--------------------------------------------------------------------------
# Backups
#--------------------------------------------------------------------------
# Nothing here is recoverable without one. Put the directory OUTSIDE the
# release folder, or a deploy that replaces it takes the backups with it.
# Off-host copies and encryption are the operator's job - see
# docs/backup-restore.md.
# BACKUP_DIRECTORY=/var/backups/mealbells
# BACKUP_KEEP_DAYS=14
# BACKUP_STALE_AFTER_HOURS=36
# BACKUP_MINIMUM_BYTES=1024
# BACKUP_TIMEOUT_SECONDS=900
# Set when pg_dump is not on the web user's PATH, which is common.
# BACKUP_PG_DUMP_PATH=/usr/bin/pg_dump

# Health check endpoint
#--------------------------------------------------------------------------
# /up only proves the application boots; it stays green with the database down
# and the worker stopped. /health/ping checks the database, the scheduler
# heartbeat, failed jobs, whether anything is draining the queue, and the HRMS
# pulls - 200 when all are well, 503 otherwise.
#
# With no token it answers 404 and is effectively off. Generate one with
# `php artisan mealbells:health-token`. See docs/deploy.md for the monitor setup.
# HEALTH_PING_TOKEN=
# HEALTH_SCHEDULER_STALE_AFTER_MINUTES=3
# HEALTH_FAILED_JOBS_THRESHOLD=25
# HEALTH_PENDING_JOB_STALE_AFTER_MINUTES=10
# A stale pull looks exactly like a quiet day with no leave, so by default it
# fails the endpoint. Set false to report it without paging anyone.
# HEALTH_PULL_STALENESS_FAILS=true

# Security headers
#--------------------------------------------------------------------------
# HSTS is only ever sent over HTTPS. One year is the usual value; start lower
# if you are not yet certain every subdomain can serve https.
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_CSP_ENABLED=true
# False sends Content-Security-Policy-Report-Only: the browser reports what it
# would have blocked and nothing breaks. Turn enforcement on only once those
# reports are quiet - the policy still needs 'unsafe-inline' for scripts,
# because Inertia writes the page payload into a script tag.
# SECURITY_CSP_ENFORCE=false

# HEALTH_ALERTS_ENABLED=true
# Comma-separated. Empty means every active super admin.
# HEALTH_ALERT_RECIPIENTS=
# Minutes before the same unresolved issue is mailed again. The command runs
# every five minutes, so without this a dead worker sends twelve mails an hour
# and gets filtered - at which point the alerting is worse than none.
# HEALTH_ALERT_REPEAT_AFTER_MINUTES=60

# Error tracking (optional)
#--------------------------------------------------------------------------
# With no DSN the SDK initialises nothing, reports nothing and makes no
# network calls, so leaving this unset is a complete opt-out.
#
# Everything that IS sent passes through App\Observability\SentryScrubber:
# passwords, tokens, signatures, cookies, HRMS payloads, employee codes and
# addresses are stripped, and the user is reduced to an id and a role. SQL
# bindings and send_default_pii are forced off in config and are not tunable.
# SENTRY_DSN=
# Which build an error came from. Set it in the deploy script - without it
# every regression looks like it has always been there.
# SENTRY_RELEASE=
# Defaults to APP_ENV. Without it a staging error wakes someone up.
# SENTRY_ENVIRONMENT=
# Fraction of errors sent (1.0 = all).
# SENTRY_SAMPLE_RATE=1.0
# Performance tracing. Leave unset to send none; it is a separate quota.
# SENTRY_TRACES_SAMPLE_RATE=


# MEALBELLS_DEFAULT_TIMEZONE=Asia/Kolkata

# When a day's count is flagged unusual and escalated. A company of 20 and one
# of 2,000 do not deviate alike.
# MEALBELLS_ANOMALY_DEVIATION_PERCENT=20
# MEALBELLS_ANOMALY_HISTORY_MIN_DAYS=3
# MEALBELLS_ANOMALY_MAX_EXTRA_SPIKE=10
# MEALBELLS_ANOMALY_MAX_SKIP_RATIO=0.30

#--------------------------------------------------------------------------
# HRMS integration
#--------------------------------------------------------------------------
# Per-company webhook secrets live in the encrypted company_hrms_connections
# table, not here. This config fallback is honoured in local and testing only.
# HRMS_C1_WEBHOOK_SECRET=

# Largest webhook body accepted, checked before the signature so an
# unauthenticated caller cannot make us hash arbitrary bytes. Bytes.
# HRMS_MAX_BODY_BYTES=262144

# Webhook requests per minute, per company.
# HRMS_RATE_LIMIT=300

# Days before a received payload is redacted. The row survives as the audit
# trail; the vendor's raw PII does not.
# HRMS_PAYLOAD_RETENTION_DAYS=30
# HRMS_PULL_RUN_RETENTION_DAYS=30

# How long an event may sit unfinished before the reconciliation backstop picks
# it up, and how many passes it gets before being left for a human.
# HRMS_RECONCILE_STALE_MINUTES=10
# HRMS_RECONCILE_MAX_ATTEMPTS=3

# CyberPulse pull. The token lasts 30 days and cannot be refreshed; the login
# cooldown is self-imposed because their endpoint has no rate limit of its own.
# HRMS_CP_TOKEN_DAYS=29
# HRMS_CP_LOGIN_COOLDOWN=60
# HRMS_CP_TIMEOUT=15
# HRMS_CP_PULL_MINUTES=15
# HRMS_CP_PULL_BEFORE_CUTOFF_MINUTES=20
# Attendance (shadow mode). Reads who clocked in and reports what it WOULD
# have changed; it changes no count and creates no skip. Off per company by
# default - see docs/attendance-design.md.
# Largest share of eligible employees that may look absent before a run records
# nothing. Forty percent of a company is not away; the HR system is more likely
# broken, and a wasted meal costs less than somebody going without lunch.
# HRMS_CP_MAX_ABSENT_SHARE=0.4
# Minutes before a company's cutoff that attendance is read. Later than the
# leave window on purpose, and early enough to finish before the cutoff.
# HRMS_CP_ATTENDANCE_BEFORE_CUTOFF_MINUTES=5

# A deleted leave leaves nothing to receive, so cancellation is inferred from
# absence - and a truncated fetch looks identical to a mass withdrawal. Above
# this share the run cancels nothing and is marked suspicious. The floor keeps
# ordinary single cancellations working at small scale.
# HRMS_CP_MAX_CANCEL_SHARE=0.3
# HRMS_CP_CANCELS_ALWAYS_ALLOWED=3
