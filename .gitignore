# BACKUP_DIRECTORY defaults here, so a local `mealbells:backup` leaves a full
# database dump in the working tree. Untracked and unignored, one `git add -A`
# commits every employee's name and email into the repository.
/storage/backups
# Where a company export is written before being handed over. The command
# deletes it after sending, but a crash mid-download would leave a zip of every
# employee's name and address in the working tree.
/storage/app/exports

# Astro's output for the public landing page, built by `npm run build:landing`.
# Build output, like public/build - the source is resources/landing.
/public/landing
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Astro's generated artefacts inside the landing project. `.astro` holds the
# types it regenerates on every build or dev start; `node_modules` is where its
# nested Vite writes a dependency cache. The root /node_modules rule is
# anchored, so it does not reach either of these.
/resources/landing/.astro
/resources/landing/node_modules
