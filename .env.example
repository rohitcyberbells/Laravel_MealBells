# Defaults here are PRODUCTION-safe. For local development see docs/deploy.md,
# which lists the handful of values to override (APP_ENV, APP_DEBUG,
# SESSION_SECURE_COOKIE, QUEUE_CONNECTION, LOG_*, MAIL_MAILER).

APP_NAME=MealBells
APP_ENV=production
APP_KEY=
# Never true in production: it serves stack traces, env values and database
# credentials to anyone who triggers an error.
APP_DEBUG=false
APP_URL=https://mealbells.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# 'daily' rotates; 'single' is one file that grows without bound.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' logs every query and request. Use it locally, not in production.
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# PostgreSQL is the intended production database: one migration already
# branches on the driver to use a partial unique index, and the JSON columns
# suit jsonb. SQLite is for local work and the test suite.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mealbells
DB_USERNAME=mealbells
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Without this the session cookie is sent over plain http too. Must be false
# for local development, where there is no certificate.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 'database' or 'redis' in production, and a worker MUST be running or no
# notification is ever delivered - see docs/deploy.md for the supervisor
# config. Locally 'sync' runs jobs inline and needs no worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 'log' writes mail to the log instead of sending it - correct locally, and
# silent data loss in production. Set a real transport (smtp, ses, postmark).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Employees receive their temporary password from this address, so it has to be
# one that accepts replies and passes SPF/DKIM for your domain.
MAIL_FROM_ADDRESS="noreply@mealbells.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# MealBells engine
#--------------------------------------------------------------------------
# Every value below is optional: the defaults in config/mealbells.php and
# config/hrms.php are the ones shipped. They are listed so an operator knows
# the knobs exist.

# How far ahead a meal may be recorded. Leave beyond this is reported as
# outside the window rather than applied.
# MEALBELLS_ADVANCE_LIMIT_DAYS=60
# MEALBELLS_MAX_EXTRA_MEALS=100
# Largest number of rows one CSV import may confirm.
# MEALBELLS_MAX_IMPORT_ROWS=2000

# How long the operational tables keep rows. They hold no meal records, but
# they carry user ids and job payloads. Failed jobs are kept longer than a
# session because one may still be worth retrying.
# MEALBELLS_RETENTION_SESSIONS_DAYS=30
# MEALBELLS_RETENTION_NOTIFICATIONS_DAYS=90
# MEALBELLS_RETENTION_FAILED_JOBS_DAYS=30
# MEALBELLS_DEFAULT_TIMEZONE=Asia/Kolkata

# When a day's count is flagged unusual and escalated. A company of 20 and one
# of 2,000 do not deviate alike.
# MEALBELLS_ANOMALY_DEVIATION_PERCENT=20
# MEALBELLS_ANOMALY_HISTORY_MIN_DAYS=3
# MEALBELLS_ANOMALY_MAX_EXTRA_SPIKE=10
# MEALBELLS_ANOMALY_MAX_SKIP_RATIO=0.30

#--------------------------------------------------------------------------
# HRMS integration
#--------------------------------------------------------------------------
# Per-company webhook secrets live in the encrypted company_hrms_connections
# table, not here. This config fallback is honoured in local and testing only.
# HRMS_C1_WEBHOOK_SECRET=

# Largest webhook body accepted, checked before the signature so an
# unauthenticated caller cannot make us hash arbitrary bytes. Bytes.
# HRMS_MAX_BODY_BYTES=262144

# Webhook requests per minute, per company.
# HRMS_RATE_LIMIT=300

# Days before a received payload is redacted. The row survives as the audit
# trail; the vendor's raw PII does not.
# HRMS_PAYLOAD_RETENTION_DAYS=30
# HRMS_PULL_RUN_RETENTION_DAYS=30

# How long an event may sit unfinished before the reconciliation backstop picks
# it up, and how many passes it gets before being left for a human.
# HRMS_RECONCILE_STALE_MINUTES=10
# HRMS_RECONCILE_MAX_ATTEMPTS=3

# CyberPulse pull. The token lasts 30 days and cannot be refreshed; the login
# cooldown is self-imposed because their endpoint has no rate limit of its own.
# HRMS_CP_TOKEN_DAYS=29
# HRMS_CP_LOGIN_COOLDOWN=60
# HRMS_CP_TIMEOUT=15
# HRMS_CP_PULL_MINUTES=15
# HRMS_CP_PULL_BEFORE_CUTOFF_MINUTES=20

# A deleted leave leaves nothing to receive, so cancellation is inferred from
# absence - and a truncated fetch looks identical to a mass withdrawal. Above
# this share the run cancels nothing and is marked suspicious. The floor keeps
# ordinary single cancellations working at small scale.
# HRMS_CP_MAX_CANCEL_SHARE=0.3
# HRMS_CP_CANCELS_ALWAYS_ALLOWED=3
