---
import '../styles/landing.css';

const appName = 'MealBells';
const title = `${appName} — know how many lunches to make, every morning`;
const description =
  'Every working day an office canteen has to decide how many lunches to make. MealBells works the number out from who is in, who is on leave and who said they will skip — so nobody opens an empty box and nothing goes in the bin.';

/*
 * Only emitted once a real domain is configured. A canonical pointing at a
 * placeholder is worse than none: it tells search engines the page lives
 * somewhere it does not.
 */
const site = import.meta.env.PUBLIC_SITE_URL ?? '';

/*
 * One worked day, and the numbers have to agree with each other because the
 * mock below prints all three.
 */
const ROSTER = 127;
const AWAY = 24;
const EATEN = ROSTER - AWAY;

/*
 * The rows in the mock are the real Preparation screen's columns, and they add
 * up to EATEN. A screenshot that does not survive arithmetic is the fastest way
 * to look unserious.
 */
const companies = [
  { name: 'Acme Industries', eligible: 84, skips: 17, extra: 4, status: 'Confirmed' },
  { name: 'Northwind Traders', eligible: 43, skips: 11, extra: 0, status: 'Auto-confirmed' },
];

const steps = [
  {
    head: 'Staff say when they’ll miss lunch',
    body: 'Two taps on their phone. No form, nobody to ask. If they are never in on Fridays, they set that once and forget it.',
  },
  {
    head: 'Leave comes in on its own',
    body: 'When someone’s leave or work-from-home is approved, MealBells already knows. Nobody on holiday has a lunch made for them.',
  },
  {
    head: 'The number is fixed by a set time',
    body: 'Each morning the kitchen gets one count and can start cooking. If anything changes after that they are told — the number never changes quietly behind them.',
  },
];

const roles = [
  {
    who: 'Staff',
    body: 'Say you are out tomorrow. Set the days you are never in. Ask for an extra plate when someone is visiting.',
  },
  {
    who: 'The office team',
    body: 'Add people, mark holidays, pick the time the count is fixed each day — and see tomorrow’s number before it reaches the kitchen.',
  },
  {
    who: 'The kitchen',
    body: 'One clear number every morning, split by office, and the whole week’s menu in one place.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site && <link rel="canonical" href={site} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {site && <meta property="og:url" content={site} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <!-- ------------------------------------------------------- masthead -->
    <header class="sticky top-0 z-30 border-b border-line bg-page/85 backdrop-blur-xl">
      <div class="mx-auto flex max-w-[72rem] items-center justify-between gap-6 px-5 py-3.5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${appName} home`}>
          <!-- The sidebar's mark, at the size the sidebar uses it. -->
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl text-white"
            style="background-image: linear-gradient(to top right, var(--color-cyan), var(--color-tint-emerald));"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8" />
              <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            </svg>
          </span>
          <span class="text-[15px] font-bold tracking-tight text-ink">{appName}</span>
        </a>

        <nav class="hidden items-center gap-7 sm:flex" aria-label="Main">
          <a class="text-sm font-medium text-ink-3 hover:text-ink" href="#how">How it works</a>
          <a class="text-sm font-medium text-ink-3 hover:text-ink" href="#who">Who it’s for</a>
        </nav>

        <a
          href="/login"
          class="rounded-xl bg-tint-emerald px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:brightness-110"
        >
          Sign in
        </a>
      </div>
    </header>

    <main>
      <!-- ----------------------------------------------------------- hero -->
      <section class="relative overflow-hidden">
        <!-- The application's ambient wash, behind the hero only. -->
        <div class="wash" aria-hidden="true">
          <span
            class="-top-40 -left-24 h-[30rem] w-[30rem]"
            style="background: color-mix(in srgb, var(--color-tint-emerald) 16%, transparent);"></span>
          <span
            class="-top-32 right-[-8rem] h-[34rem] w-[34rem]"
            style="background: color-mix(in srgb, var(--color-cyan) 12%, transparent);"></span>
        </div>

        <div class="relative mx-auto max-w-[72rem] px-5 pt-16 pb-10 sm:px-8 sm:pt-24">
          <p class="label text-emerald">Daily meal counts</p>

          <h1
            class="mt-4 max-w-[20ch] text-[clamp(2.2rem,6vw,3.9rem)] font-bold leading-[1.05] tracking-[-0.03em] text-ink"
          >
            Cook for the people who are actually coming in.
          </h1>

          <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-ink-3">
            Every morning the kitchen has to decide how many lunches to make. MealBells
            works it out from who is in, who is on leave and who said they will skip —
            then fixes the number by a set time, so what gets made is what gets eaten.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/login"
              class="rounded-xl bg-tint-emerald px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110"
              style="box-shadow: 0 10px 25px -8px color-mix(in srgb, var(--color-tint-emerald) 45%, transparent);"
            >
              Sign in
            </a>
            <a
              href="#how"
              class="rounded-xl border border-line-mid bg-card px-6 py-3 text-sm font-semibold text-ink-2 transition hover:bg-raised"
            >
              How it works
            </a>
          </div>

          <!-- --------------------------------------- the product, actually shown -->
          <figure class="rise mt-14 sm:mt-16">
            <div class="overflow-hidden rounded-2xl border border-line bg-card shadow-2xl shadow-slate-900/10">
              <div class="flex items-center gap-2 border-b border-line bg-raised px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-line-mid"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-line-mid"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-line-mid"></span>
                <span class="ml-2 text-xs font-medium text-ink-4">Preparation — Tuesday</span>
              </div>

              <div class="space-y-5 p-5 sm:p-7">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="label text-ink-4">Tiffins to cook</p>
                    <p class="num mt-2 text-6xl font-light leading-none text-ink sm:text-7xl">
                      {EATEN}
                      <span class="text-2xl font-normal text-ink-4">meals</span>
                    </p>
                  </div>
                  <span
                    class="inline-flex items-center gap-2 whitespace-nowrap text-sm font-semibold text-emerald"
                  >
                    <span class="h-2 w-2 shrink-0 rounded-full bg-emerald"></span>
                    Locked — this is the number
                  </span>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full border-collapse text-left">
                    <thead>
                      <tr class="label border-b border-line text-ink-4">
                        <th class="py-2 pr-3 font-semibold">Company</th>
                        <th class="px-3 py-2 text-right font-semibold">Eligible</th>
                        <th class="px-3 py-2 text-right font-semibold">Skips</th>
                        <th class="px-3 py-2 text-right font-semibold">Extra</th>
                        <th class="px-3 py-2 text-right font-semibold">To cook</th>
                        <th class="py-2 pl-3 font-semibold">Status</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-line text-sm">
                      {
                        companies.map((c) => (
                          <tr>
                            <td class="py-3 pr-3 font-medium text-ink">{c.name}</td>
                            <td class="num px-3 py-3 text-right text-ink-3">{c.eligible}</td>
                            <td class="num px-3 py-3 text-right text-rose">&minus;{c.skips}</td>
                            <td class="num px-3 py-3 text-right text-emerald">+{c.extra}</td>
                            <td class="num px-3 py-3 text-right text-lg font-semibold text-ink">
                              {c.eligible - c.skips + c.extra}
                            </td>
                            <td class="py-3 pl-3">
                              <span class="inline-flex items-center gap-1.5 whitespace-nowrap text-xs font-semibold text-emerald">
                                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald" />
                                {c.status}
                              </span>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <figcaption class="mt-3 text-center text-xs text-ink-4">
              What the kitchen sees on a day when {ROSTER} people are on the list and {AWAY} are away.
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ------------------------------------------------------ how it works -->
      <section id="how" class="mx-auto max-w-[72rem] scroll-mt-20 px-5 py-16 sm:px-8 sm:py-24">
        <p class="label rise text-emerald">How it works</p>
        <h2
          class="rise mt-3 max-w-[22ch] text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold leading-tight tracking-[-0.02em] text-ink"
        >
          It works itself out, then stops changing.
        </h2>

        <ol class="mt-10 grid gap-5 sm:grid-cols-3">
          {
            steps.map((step, i) => (
              <li class="rise rounded-2xl border border-line bg-card p-6">
                <span class="num text-sm font-semibold text-emerald">0{i + 1}</span>
                <h3 class="mt-3 text-base font-semibold text-ink">{step.head}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-3">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ----------------------------------------------------- the arithmetic -->
      <section class="border-y border-line bg-card">
        <div class="mx-auto max-w-[72rem] px-5 py-14 sm:px-8">
          <dl class="rise flex flex-wrap items-baseline gap-x-14 gap-y-6">
            <div>
              <dt class="label text-ink-4">People on the list</dt>
              <dd class="num mt-1.5 text-4xl font-light text-ink">{ROSTER}</dd>
            </div>
            <div>
              <dt class="label text-ink-4">Away that day</dt>
              <dd class="num mt-1.5 text-4xl font-light text-ink">{AWAY}</dd>
            </div>
            <div>
              <dt class="label text-emerald">Cooked, and eaten</dt>
              <dd class="num mt-1.5 text-4xl font-light text-emerald">{EATEN}</dd>
            </div>
            <p class="max-w-[34ch] text-sm leading-relaxed text-ink-3">
              Most places count heads and add a few extra, just in case. Those extra
              lunches get made, paid for and thrown away — every single day.
            </p>
          </dl>
        </div>
      </section>

      <!-- -------------------------------------------------------- who it's for -->
      <section id="who" class="mx-auto max-w-[72rem] scroll-mt-20 px-5 py-16 sm:px-8 sm:py-24">
        <p class="label rise text-emerald">Who it’s for</p>
        <h2
          class="rise mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold leading-tight tracking-[-0.02em] text-ink"
        >
          Three people, one number.
        </h2>

        <div class="mt-10 grid gap-5 sm:grid-cols-3">
          {
            roles.map((role) => (
              <div class="rise rounded-2xl border border-line bg-card p-6">
                <h3 class="text-base font-semibold text-ink">{role.who}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-3">{role.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- --------------------------------------------------------------- close -->
      <section class="border-t border-line bg-card">
        <div class="mx-auto max-w-[72rem] px-5 py-16 text-center sm:px-8 sm:py-20">
          <h2
            class="rise mx-auto max-w-[20ch] text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold leading-tight tracking-[-0.02em] text-ink"
          >
            Stop cooking for people who aren’t there.
          </h2>
          <p class="rise mx-auto mt-4 max-w-[44ch] text-base leading-relaxed text-ink-3">
            There is no sign-up. Staff get their login from their own office team, and
            offices and kitchens are set up by us.
          </p>
          <div class="rise mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/login"
              class="rounded-xl bg-tint-emerald px-7 py-3.5 text-sm font-semibold text-white transition hover:brightness-110"
              style="box-shadow: 0 10px 25px -8px color-mix(in srgb, var(--color-tint-emerald) 45%, transparent);"
            >
              Sign in
            </a>
            <a
              href="mailto:hello@example.com"
              class="rounded-xl border border-line-mid px-7 py-3.5 text-sm font-semibold text-ink-2 transition hover:bg-raised"
            >
              Talk to us
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[72rem] flex-wrap items-center justify-between gap-4 px-5 py-8 text-xs text-ink-4 sm:px-8"
      >
        <span>&copy; {new Date().getFullYear()} {appName}</span>
        <a href="/login" class="font-medium hover:text-ink">Sign in</a>
      </div>
    </footer>

    <script>
      import { initExperience } from '../scripts/experience.js';

      initExperience();
    </script>
  </body>
</html>
