---
import '../styles/landing.css';

/*
 * Scaffolding, not the finished page. It exists so the build pipeline is real
 * and tested; the design goes here.
 *
 * Two constraints worth knowing before adding to it:
 *
 * 1. This file is served through Laravel, so the application's
 *    Content-Security-Policy applies - script-src is 'self' and 'unsafe-inline'
 *    only. A <script src> from a CDN will be blocked. Anything third-party
 *    (a model viewer, an analytics snippet) has to be installed with npm so it
 *    is bundled and served from this origin.
 *
 * 2. There is no database access here. The page is static HTML built ahead of
 *    time. Anything dynamic needs an endpoint in Laravel and a fetch.
 */
const appName = 'MealBells';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{appName}</title>
    <meta
      name="description"
      content="MealBells tells your tiffin vendor how many lunches to cook, every day, before the kitchen starts."
    />
  </head>

  <body class="min-h-screen bg-slate-950 text-white antialiased">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-8 px-4 py-16">
      <div class="space-y-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400">{appName}</p>

        <h1 class="text-4xl font-bold leading-tight sm:text-5xl">
          The kitchen gets one number, and it is the right one.
        </h1>

        <p class="max-w-xl text-base text-slate-400">
          Employees say when they are not eating. MealBells counts, locks the number at your cutoff,
          and tells the vendor &mdash; so nobody cooks forty lunches for twenty-eight people.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/login"
          class="rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-bold text-slate-950 transition hover:bg-emerald-400"
        >
          Sign in
        </a>
      </div>

      <p class="text-xs text-slate-600">
        This page is scaffolding. The design is still to come.
      </p>
    </main>
  </body>
</html>
