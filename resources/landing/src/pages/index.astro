---
import '../styles/landing.css';

const appName = 'MealBells';
const title = `${appName} — Smarter Meal Planning`;
const description =
  'MealBells helps companies and catering vendors plan meal preparation with better demand visibility.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f7f6fc" />

    <link rel="canonical" href="https://your-domain.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://your-domain.com/" />
  </head>


  <body>
    <header class="site-header">
      <a class="logo" href="/" aria-label="MealBells home">
        MealBells
      </a>

      <nav aria-label="Main navigation">
        <a href="#how-it-works">How it works</a>
        <a href="#benefits">Benefits</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="header-cta" href="#contact">
        Get started
      </a>
    </header>

    <main>
      <section id="stage" class="stage">
        <canvas id="scene" aria-hidden="true"></canvas>
        <!-- beat divs yahan -->
      </section>

      <section
        class="hero"
        id="hero"
        aria-labelledby="hero-title"
      >
        <!-- Shared Three.js canvas will be mounted here. -->
        <div
          class="scene-container"
          id="mealbells-scene"
          aria-hidden="true"
        ></div>

        <!-- Keep meaningful content in HTML, not inside WebGL. -->
        <div class="hero-content">
          <p class="eyebrow">Smarter meal planning</p>

          <h1 id="hero-title">
            Every meal.
            <span>Better planned.</span>
          </h1>

          <p class="hero-description">
            Give your catering team better visibility into expected
            meals, so they can prepare smarter and reduce food waste.
          </p>

          <a class="primary-cta" href="#how-it-works">
            Discover MealBells
          </a>
        </div>

        <p class="scroll-hint" aria-hidden="true">
          Scroll to explore
        </p>
      </section>

      <section id="how-it-works" class="content-section">
        <p class="eyebrow">How it works</p>
        <h2>Turn meal decisions into preparation clarity.</h2>
        <p>
          Understand expected meal demand before preparation begins.
        </p>
      </section>

      <section id="benefits" class="content-section">
        <p class="eyebrow">Why MealBells</p>
        <h2>Better visibility for teams and vendors.</h2>
        <p>
          Make meal planning more predictable with clearer demand
          information.
        </p>
      </section>

      <section id="contact" class="content-section">
        <h2>Let's plan smarter.</h2>
        <a href="mailto:hello@your-domain.com">
          Contact MealBells
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} MealBells.</p>
    </footer>

    <script>
      import { initExperience } from '../scripts/experience.js';

      initExperience();
    </script>
  </body>
</html>
